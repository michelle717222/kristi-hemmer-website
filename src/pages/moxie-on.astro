---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="MOXIE ON - Take Action with Kristi Hemmer">
  <Header />

  <main>
    <!-- Hero Section -->
  <section class="relative py-20 md:py-32 overflow-hidden" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF0 50%, #FFF3E0 100%);">
    <!-- Starburst graphic -->
    <div class="absolute top-10 right-10 w-40 h-40 opacity-10">
      <div class="w-full h-full bg-moxie-pink transform rotate-12" style="clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%)"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-['Open Sans'] text-6xl md:text-8xl mb-6 text-moxie-pink">
          MOXIE ON!
        </h1>
        <h2 class="text-3xl md:text-5xl font-bold mb-8 leading-tight text-charcoal">
          You've Felt the Spark — Now Do Something With It
        </h2>
        <p class="text-xl md:text-2xl mb-6 leading-relaxed text-gray-700">
          Your next step doesn't have to be perfect — it just has to be bold
        </p>
        <p class="text-lg md:text-xl max-w-2xl mx-auto leading-relaxed text-gray-700">
          Whether you're leading a team, launching a dream, or just tired of playing small, your next step is here.
          <span class="font-bold text-charcoal">Don't stay stuck.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Choose Your MOXIE Move -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Let's Find Your MOXIE Move</h2>
        <p class="text-xl text-gray-700 max-w-2xl mx-auto">
          However you move forward — just don't stay stuck. Choose what calls to you:
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- Card 1: Hire Kristi As Speaker -->
        <div class="bg-neutral-200 rounded-2xl p-8 hover:shadow-2xl transition-shadow duration-300">
          <img src="/images/Graphic Elements_Pink_01.png" alt="" class="w-16 h-16 mb-4" aria-hidden="true" />
          <h3 class="text-3xl font-bold mb-4">Change a community</h3>
          <p class="text-lg mb-6 leading-relaxed">
            Book Kristi for keynotes and workshops that inspire action and spark transformation for women's leadership.
          </p>
          <a href="/services/speaking" class="inline-block bg-moxie-pink text-white font-bold py-4 px-8 rounded-full hover:bg-white hover:text-charcoal transition-colors duration-300">
            Book Kristi to Speak
          </a>
        </div>

        <!-- Card 2: Join the Moxie Movement -->
        <div class="bg-moxie-pink text-white rounded-2xl p-8 hover:shadow-2xl transition-shadow duration-300">
          <img src="/images/Graphic Elements_Yellow_02.png" alt="" class="w-16 h-16 mb-4" aria-hidden="true" />
          <h3 class="text-3xl font-bold mb-4">Join the Moxie Movement</h3>
          <p class="text-lg mb-6 leading-relaxed">
            Sign up for Kristi's Substack monthly newsletter. Get insights on women's leadership, power dynamics, and authentic change.
          </p>
          <a href="https://kristihemmer.substack.com" target="_blank" rel="noopener noreferrer" class="inline-block bg-sunny-yellow text-black font-bold py-4 px-8 rounded-full hover:bg-white hover:text-charcoal transition-colors duration-300">
            Subscribe to Newsletter
          </a>
        </div>

        <!-- Card 3: Buy Kristi's Book -->
        <div class="bg-sunny-yellow text-black rounded-2xl p-8 hover:shadow-2xl transition-shadow duration-300">
          <img src="/images/Graphic Elements_Pink_03.png" alt="" class="w-16 h-16 mb-4" aria-hidden="true" />
          <h3 class="text-3xl font-bold mb-4">Have Kristi in your back pocket</h3>
          <p class="text-lg mb-6 leading-relaxed">
            "Quit Being So Good" — Stop performing goodness and start claiming your power.
          </p>
          <a href="/book" class="inline-block bg-moxie-pink text-white font-bold py-4 px-8 rounded-full hover:bg-charcoal transition-colors duration-300">
            Buy the Book
          </a>
        </div>

        <!-- Card 4: Book a Moxie Mission Session -->
        <div class="bg-charcoal text-white rounded-2xl p-8 hover:shadow-2xl transition-shadow duration-300">
          <img src="/images/Graphic Elements_Pink_04.png" alt="" class="w-16 h-16 mb-4" aria-hidden="true" />
          <h3 class="text-3xl font-bold mb-4">Take up space—unapologetically</h3>
          <p class="text-lg mb-6 leading-relaxed">
            90 minutes of focused clarity and action. Perfect for a specific challenge or decision point.
          </p>
          <a href="/services/coaching#booking" class="inline-block bg-sunny-yellow text-black font-bold py-4 px-8 rounded-full hover:bg-white hover:text-charcoal transition-colors duration-300">
            Book a Coaching Session
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <!-- NOTE: To activate email delivery, sign up free at formspree.io, create a form pointed -->
  <!-- to kristihemmer@gmail.com, and replace "YOUR_FORM_ID" below with your form's ID.     -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl md:text-5xl font-bold mb-4 text-charcoal">
            Get in <span class="text-moxie-pink">Touch</span>
          </h2>
          <p class="text-xl text-gray-700">
            Ready to take the next step? Send a message and Kristi will be in touch soon.
          </p>
        </div>

        <form
          action="https://formspree.io/f/mlgpgvor"
          method="POST"
          class="bg-white rounded-2xl shadow-lg p-8 md:p-10 space-y-6"
        >
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-bold text-charcoal mb-2">
              Your Name <span class="text-moxie-pink">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="First and last name"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:border-moxie-pink focus:ring-2 focus:ring-moxie-pink focus:ring-opacity-20 transition-colors"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-bold text-charcoal mb-2">
              Email Address <span class="text-moxie-pink">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:border-moxie-pink focus:ring-2 focus:ring-moxie-pink focus:ring-opacity-20 transition-colors"
            />
          </div>

          <!-- Interest -->
          <div>
            <label for="interest" class="block text-sm font-bold text-charcoal mb-2">
              I'm interested in…
            </label>
            <select
              id="interest"
              name="interest"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:border-moxie-pink focus:ring-2 focus:ring-moxie-pink focus:ring-opacity-20 transition-colors bg-white"
            >
              <option value="">Select an option</option>
              <option value="Speaking / Keynotes">Speaking / Keynotes</option>
              <option value="Coaching">Coaching</option>
              <option value="Travel & Adventure">Travel & Adventure</option>
              <option value="Emcee Services">Emcee Services</option>
              <option value="General Inquiry">General Inquiry</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-bold text-charcoal mb-2">
              Message <span class="text-moxie-pink">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Tell Kristi what's on your mind…"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-base focus:outline-none focus:border-moxie-pink focus:ring-2 focus:ring-moxie-pink focus:ring-opacity-20 transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-moxie-pink text-white font-bold py-4 px-8 rounded-lg hover:bg-moxie-pink-alt transition-colors text-lg"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>
  </main>

  <Footer />

  <style>
    @keyframes shake {
      0%, 100% { transform: translateX(0) rotate(0deg); }
      10%, 30%, 50%, 70%, 90% { transform: translateX(-5px) rotate(-2deg); }
      20%, 40%, 60%, 80% { transform: translateX(5px) rotate(2deg); }
    }

    .shake-it {
      animation: shake 0.5s ease-in-out;
    }

    @keyframes particle-burst {
      0% {
        transform: translate(0, 0) scale(1);
        opacity: 1;
      }
      100% {
        transform: translate(var(--tx), var(--ty)) scale(0);
        opacity: 0;
      }
    }

    .particle {
      position: fixed;
      pointer-events: none;
      z-index: 9999;
      animation: particle-burst 0.8s ease-out forwards;
    }

    .star-particle {
      width: 20px;
      height: 20px;
      clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    }

    .circle-particle {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }
  </style>

  <script>
    // Add hover animation to all CTA buttons
    const ctaButtons = document.querySelectorAll('a[href*="/services"], a[href*="amazon"], a[href*="substack"]');

    ctaButtons.forEach(button => {
      button.addEventListener('mouseenter', function(e) {
        // Shake the button
        this.classList.add('shake-it');
        setTimeout(() => {
          this.classList.remove('shake-it');
        }, 500);

        // Get button position and size
        const rect = this.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        // Create particle burst from button center
        createParticleBurst(centerX, centerY);
      });
    });

    function createParticleBurst(x, y) {
      const particleCount = 15;
      const colors = ['#E91C7E', '#FCEC60', '#F096C1', '#D94780'];

      for (let i = 0; i < particleCount; i++) {
        const particle = document.createElement('div');
        particle.classList.add('particle');

        // Mix of stars and circles
        if (Math.random() > 0.5) {
          particle.classList.add('star-particle');
        } else {
          particle.classList.add('circle-particle');
        }

        // Random color from brand palette
        particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];

        // Position at button center
        particle.style.left = x + 'px';
        particle.style.top = y + 'px';

        // Random direction
        const angle = (Math.PI * 2 * i) / particleCount;
        const velocity = 100 + Math.random() * 100;
        const tx = Math.cos(angle) * velocity;
        const ty = Math.sin(angle) * velocity;

        particle.style.setProperty('--tx', tx + 'px');
        particle.style.setProperty('--ty', ty + 'px');

        document.body.appendChild(particle);

        // Remove particle after animation
        setTimeout(() => {
          particle.remove();
        }, 800);
      }
    }
  </script>
</BaseLayout>
