---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Retreats & Travel | Kristi Hemmer"
  description="PoWer Treats and PoWer Trips. Transformational retreats and adventure journeys to reclaim your MOXIE."
>
  <Header />

  <main>
    <!-- SECTION 1: Hero Section -->
    <section class="py-20 md:py-32" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF0 50%, #FFF3E0 100%);">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <div>
            <h1 class="text-5xl md:text-6xl font-bold mb-6">
              <span class="text-moxie-pink">Retreats</span> & Travel
            </h1>
            <p class="text-xl text-gray-700 mb-8 leading-relaxed">
              For creatives who are still DONE waiting to get their idea out into the world. Includes individual/group coaching and 3-4 days on the water to play (have fun), pause (restore), and project (create).
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#upcoming" class="bg-moxie-pink text-white font-bold px-8 py-4 rounded-lg hover:bg-moxie-pink-alt transition-all transform hover:scale-105 text-lg text-center">
                See Upcoming Retreats
              </a>
              <a href="/moxie-on" class="border-2 border-moxie-pink text-moxie-pink font-bold px-8 py-4 rounded-lg hover:bg-moxie-pink hover:text-white transition-all text-lg text-center">
                Get on the List
              </a>
            </div>
          </div>

          <div class="relative">
            <img
              src="/images/travel-2.jpg"
              alt="Kristi Hemmer retreat and travel experience"
              class="rounded-lg shadow-2xl w-full"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Upcoming Retreats & Trips (combined) -->
    <section id="upcoming" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-4xl md:text-5xl font-bold text-center mb-12">
            Upcoming <span class="text-moxie-pink">Retreats & Trips</span>
          </h2>

          <div class="space-y-8">
            <!-- Summer Fun -->
            <div class="border-l-4 border-moxie-pink pl-6 py-2">
              <h3 class="text-2xl font-bold mb-1">Summer Fun</h3>
              <p class="text-gray-500 font-medium mb-3">May 29–31, 2026 (Fri–Sun)</p>
              <p class="text-gray-700 mb-4">
                Summer Vacation Vibes with a weekend of creativity, connection, and MOXIE on the water.
              </p>
              <a href="/moxie-on" class="inline-block bg-moxie-pink text-white font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink-alt transition-colors text-sm">
                Get on the list!
              </a>
            </div>

            <!-- Habitat for Humanity Women Build -->
            <div class="border-l-4 border-moxie-pink pl-6 py-2">
              <h3 class="text-2xl font-bold mb-1">Habitat for Humanity Women Build</h3>
              <p class="text-gray-500 font-medium mb-3">July 11–14, 2026</p>
              <p class="text-gray-700 mb-4">
                Combine service with retreat. Build a house with other women, build community, and build confidence to build your future.
              </p>
              <a href="/moxie-on" class="inline-block bg-moxie-pink text-white font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink-alt transition-colors text-sm">
                Get on the list!
              </a>
            </div>

            <!-- The Badlands -->
            <div class="border-l-4 border-moxie-pink pl-6 py-2">
              <h3 class="text-2xl font-bold mb-1">The Badlands</h3>
              <p class="text-gray-500 font-medium mb-3">September, 2026</p>
              <p class="text-gray-700 mb-4">
                Experience the creative energy of the Badlands and Hot Springs with your breath, your idea, and your people. Inquire if curious.
              </p>
              <a href="/moxie-on" class="inline-block bg-moxie-pink text-white font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink-alt transition-colors text-sm">
                Get on the list!
              </a>
            </div>

            <!-- Bali -->
            <div class="border-l-4 border-moxie-pink pl-6 py-2">
              <h3 class="text-2xl font-bold mb-1">Bali</h3>
              <p class="text-gray-500 font-medium mb-3">December, 2026</p>
              <p class="text-gray-700 mb-4">
                Kristi is finally ready to take a very small group of women to Bali with her.
              </p>
              <a href="/moxie-on" class="inline-block bg-moxie-pink text-white font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink-alt transition-colors text-sm">
                Get on the list!
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: What to Expect -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-4xl md:text-5xl font-bold text-center mb-12">
            What to <span class="text-moxie-pink">Expect</span>
          </h2>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center p-6">
              <div class="w-16 h-16 bg-moxie-pink rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-white text-2xl">▶</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Play</h3>
              <p class="text-gray-700">
                Have fun. Adventure. Explore. Remember what it feels like to be joyful.
              </p>
            </div>

            <div class="text-center p-6">
              <div class="w-16 h-16 bg-moxie-pink rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-white text-2xl">||</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Pause</h3>
              <p class="text-gray-700">
                Restore. Reflect. Create space for what matters most.
              </p>
            </div>

            <div class="text-center p-6">
              <div class="w-16 h-16 bg-moxie-pink rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-white text-2xl">★</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Project</h3>
              <p class="text-gray-700">
                Create. Build. Bring your ideas to life with support and accountability.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: Final CTA -->
    <section class="py-20" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF0 50%, #FFF3E0 100%);">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-5xl md:text-6xl font-bold mb-6 text-charcoal">
          Ready for <span class="text-moxie-pink">Adventure</span>?
        </h2>
        <p class="text-2xl mb-12 max-w-3xl mx-auto text-gray-700">
          Join us for a transformational experience that will reclaim your MOXIE.
        </p>

        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a href="/moxie-on" class="bg-moxie-pink text-white font-bold px-10 py-5 rounded-lg hover:bg-moxie-pink-alt transition-all transform hover:scale-105 text-xl">
            Get on the List
          </a>
          <a href="https://calendly.com/kristihemmer/30min" target="_blank" rel="noopener noreferrer" class="border-2 border-moxie-pink text-moxie-pink font-bold px-10 py-5 rounded-lg hover:bg-moxie-pink hover:text-white transition-all text-xl">
            Schedule a Call
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
