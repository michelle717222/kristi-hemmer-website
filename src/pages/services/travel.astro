---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Travel & Adventure | Kristi Hemmer"
  description="PoWer Treats and PoWer Trips. Transformational travel and adventure journeys to reclaim your MOXIE."
>
  <Header />

  <main>
    <!-- SECTION 1: Hero Section -->
    <section class="py-20 md:py-32" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF0 50%, #FFF3E0 100%);">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <div>
            <h1 class="text-5xl md:text-6xl font-bold mb-4">
              <span class="text-moxie-pink">SOJOURNERS:</span>
            </h1>
            <p class="text-2xl font-bold mb-6 text-gray-800">
              Where coaching, travel, and moxie meet
            </p>
            <p class="text-xl text-gray-700 mb-8 leading-relaxed">
              For creatives who are still DONE waiting to get their idea out into the world. Includes individual/group coaching and 3-4 days on the water to play (have fun), pause (restore), and poWer (create).
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#upcoming" class="bg-moxie-pink text-white font-bold px-8 py-4 rounded-lg hover:bg-moxie-pink-alt transition-all transform hover:scale-105 text-lg text-center">
                See Upcoming Adventures
              </a>
              <a href="/moxie-on" class="border-2 border-moxie-pink text-moxie-pink font-bold px-8 py-4 rounded-lg hover:bg-moxie-pink hover:text-white transition-all text-lg text-center">
                Get on the List
              </a>
            </div>
          </div>

          <div class="relative">
            <img
              src="/images/travel-2.jpg"
              alt="Kristi Hemmer travel and adventure experience"
              class="rounded-lg shadow-2xl w-full"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Upcoming Retreats & Trips (combined) -->
    <section id="upcoming" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-4xl md:text-5xl font-bold text-center mb-12">
            Upcoming <span class="text-moxie-pink">Travel & Adventures</span>
          </h2>

          <div class="space-y-16">
            <!-- Sojourners:Ground -->
            <div class="grid md:grid-cols-2 gap-8 items-center">
              <div class="order-2 md:order-1">
                <h3 class="text-3xl font-bold mb-1">
                  <span class="text-moxie-pink">Sojourners:</span>Ground
                </h3>
                <p class="text-gray-500 font-medium mb-3">Black Hills, SD &middot; October 1&ndash;4, 2026 &middot; 1 spot left</p>
                <p class="text-gray-700 mb-4">
                  Ground in nature (Black Hills/Badlands), in yourself (creating what's next), in community (a small group of women), and in good (hope).
                </p>
                <div class="flex flex-wrap gap-3">
                  <a href="/moxie-on" class="inline-block bg-moxie-pink text-white font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink-alt transition-colors text-sm">
                    Get on the list!
                  </a>
                  <a href="/pdfs/SojournersGROUND1pager2026.pdf" download class="inline-block border-2 border-moxie-pink text-moxie-pink font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink hover:text-white transition-colors text-sm">
                    Download One Pager
                  </a>
                </div>
              </div>
              <div class="order-1 md:order-2">
                <img
                  src="/pdfs/SojournersGROUNDshow&tell.jpg"
                  alt="Sojourners: Ground retreat in the Black Hills and Badlands"
                  class="rounded-lg shadow-xl w-full"
                />
              </div>
            </div>

            <!-- Sojourners:Gather -->
            <div class="grid md:grid-cols-2 gap-8 items-center">
              <div>
                <img
                  src="/pdfs/SojournersGATHERshow&tell.jpg"
                  alt="Sojourners: Gather retreat on a lake in Minnesota"
                  class="rounded-lg shadow-xl w-full"
                />
              </div>
              <div>
                <h3 class="text-3xl font-bold mb-1">
                  <span class="text-moxie-pink">Sojourners:</span>Gather
                </h3>
                <p class="text-gray-500 font-medium mb-3">On a lake in MN &middot; November 6&ndash;8, 2026 &middot; 3 spots left</p>
                <p class="text-gray-700 mb-4">
                  Gather ideas (for a business, podcast, next big idea), words (reading and writing), women (a small group), and leaves (up north on a lake in MN).
                </p>
                <div class="flex flex-wrap gap-3">
                  <a href="/moxie-on" class="inline-block bg-moxie-pink text-white font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink-alt transition-colors text-sm">
                    Get on the list!
                  </a>
                  <a href="/pdfs/SojournersGATHER1pager.pdf" download class="inline-block border-2 border-moxie-pink text-moxie-pink font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink hover:text-white transition-colors text-sm">
                    Download One Pager
                  </a>
                </div>
              </div>
            </div>

            <!-- Sojourners:Release -->
            <div class="grid md:grid-cols-2 gap-8 items-center">
              <div class="order-2 md:order-1">
                <h3 class="text-3xl font-bold mb-1">
                  <span class="text-moxie-pink">Sojourners:</span>Release
                </h3>
                <p class="text-gray-500 font-medium mb-3">Aruba &middot; December 2&ndash;6, 2026 &middot; 3 spots left</p>
                <p class="text-gray-700 mb-4">
                  Release what doesn't serve you to make room for 2027.
                </p>
                <div class="flex flex-wrap gap-3">
                  <a href="/moxie-on" class="inline-block bg-moxie-pink text-white font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink-alt transition-colors text-sm">
                    Get on the list!
                  </a>
                  <a href="/pdfs/SojournersRELEASE1pager2026.pdf" download class="inline-block border-2 border-moxie-pink text-moxie-pink font-bold px-6 py-2 rounded-lg hover:bg-moxie-pink hover:text-white transition-colors text-sm">
                    Download One Pager
                  </a>
                </div>
              </div>
              <div class="order-1 md:order-2">
                <img
                  src="/pdfs/SojournersRELEASEshow&tell.jpg"
                  alt="Sojourners: Release retreat in Aruba"
                  class="rounded-lg shadow-xl w-full"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: What to Expect -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-4xl md:text-5xl font-bold text-center mb-12">
            What to <span class="text-moxie-pink">Expect</span>
          </h2>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center p-6">
              <div class="w-16 h-16 bg-moxie-pink rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-white text-2xl">▶</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Play</h3>
              <p class="text-gray-700">
                Have fun. Adventure. Explore. Remember what it feels like to be joyful.
              </p>
            </div>

            <div class="text-center p-6">
              <div class="w-16 h-16 bg-moxie-pink rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-white text-2xl">||</span>
              </div>
              <h3 class="text-xl font-bold mb-3">Pause</h3>
              <p class="text-gray-700">
                Restore. Reflect. Create space for what matters most.
              </p>
            </div>

            <div class="text-center p-6">
              <div class="w-16 h-16 bg-moxie-pink rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-white text-2xl">★</span>
              </div>
              <h3 class="text-xl font-bold mb-3">poWer</h3>
              <p class="text-gray-700">
                Create. Build. Bring your ideas to life with support and accountability.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: Final CTA -->
    <section class="py-20" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF0 50%, #FFF3E0 100%);">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-5xl md:text-6xl font-bold mb-6 text-charcoal">
          Ready for <span class="text-moxie-pink">Adventure</span>?
        </h2>
        <p class="text-2xl mb-12 max-w-3xl mx-auto text-gray-700">
          Join us for a transformational experience that will reclaim your MOXIE.
        </p>

        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a href="/moxie-on" class="bg-moxie-pink text-white font-bold px-10 py-5 rounded-lg hover:bg-moxie-pink-alt transition-all transform hover:scale-105 text-xl">
            Get on the List
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
