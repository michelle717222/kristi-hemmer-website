---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Quit Being So Good | Kristi Hemmer" description="Order 'Quit Being So Good' by Kristi Hemmer — fifteen stories from the frontlines of being female. A call to be unapologetic, embrace your MOXIE, and claim your power.">
  <Header />

  <main>

    <!-- HERO -->
    <section class="py-16 md:py-24" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF0 50%, #FFF3E0 100%);">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">

          <!-- Book Cover -->
          <div class="flex justify-center md:justify-end order-1 md:order-2">
            <div class="relative">
              <div class="absolute -inset-4 bg-moxie-pink rounded-2xl opacity-10 blur-xl"></div>
              <img
                src="/images/QBSGcoverHemmer-400.png"
                alt="Quit Being So Good book cover by Kristi Hemmer"
                class="relative w-full max-w-[320px] md:max-w-[380px] shadow-2xl rounded-xl"
              />
            </div>
          </div>

          <!-- Text -->
          <div class="order-2 md:order-1">
            <p class="text-sm uppercase tracking-widest text-moxie-pink font-bold mb-3">The Book</p>
            <h1 class="text-5xl md:text-6xl font-bold text-charcoal leading-tight mb-6">
              Quit Being<br /><span class="text-moxie-pink">So Good.</span>
            </h1>
            <p class="text-xl text-gray-700 leading-relaxed mb-4">
              <em>Have you been talked over? Had your ideas credited to somebody else? Been excluded from the meeting where decisions are made that impact your future?</em>
            </p>
            <p class="text-xl text-gray-700 leading-relaxed mb-8">
              Kristi Hemmer sees you. This is fifteen stories from the frontlines of being female — a call to be unapologetic, embrace your MOXIE, and model <strong>#womensupportingwomen</strong>.
            </p>

            <!-- Price + Buy -->
            <div class="bg-white rounded-2xl shadow-xl p-8 inline-block w-full max-w-sm">
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-4xl font-bold text-charcoal">$18.95</span>
                <span class="text-gray-500 text-lg">+ $5.95 shipping</span>
              </div>
              <p class="text-sm text-gray-400 mb-6">Ships within the United States</p>

              <!-- PayPal Button -->
              <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_top">
                <input type="hidden" name="cmd" value="_xclick" />
                <input type="hidden" name="business" value="kristihemmer@gmail.com" />
                <input type="hidden" name="item_name" value="Quit Being So Good — Book by Kristi Hemmer" />
                <input type="hidden" name="amount" value="18.95" />
                <input type="hidden" name="shipping" value="5.95" />
                <input type="hidden" name="currency_code" value="USD" />
                <input type="hidden" name="no_shipping" value="2" />
                <input type="hidden" name="return" value="https://kristihemmer.com/thank-you" />
                <button
                  type="submit"
                  class="w-full bg-[#0070BA] hover:bg-[#005ea6] text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg flex items-center justify-center gap-3"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 101.7 121.7" class="h-6 w-auto fill-white">
                    <path d="M83.5 17.3C80.4 6.7 71.7 2.8 60.4 2.8H26.6c-2.3 0-4.3 1.7-4.6 4L8.3 97.5c-.3 1.7 1 3.3 2.7 3.3h19.7l5-31.5-.2 1c.4-2.3 2.3-4 4.6-4h9.6c18.7 0 33.3-7.6 37.6-29.6.1-.6.2-1.3.3-1.9 0 0 0 0 0 0 1.3-8-.1-13.5-4.1-17.5z"/>
                    <path d="M87.6 35.3c-.1.6-.2 1.3-.3 1.9-4.3 22-18.9 29.6-37.6 29.6h-9.6c-2.3 0-4.3 1.7-4.6 4l-7 44.5c-.3 1.5.9 2.9 2.4 2.9h16.7c2 0 3.7-1.5 4-3.5l.2-.8 3.2-20.1.2-1.1c.3-2 2-3.5 4-3.5h2.5c16.4 0 29.2-6.7 33-26 1.6-8.1.8-14.9-3.4-19.7-.9-1-2-1.8-3.7-2.2z"/>
                  </svg>
                  Buy Now — $18.95 + Shipping
                </button>
              </form>

              <p class="text-xs text-gray-400 mt-3 text-center">
                Secure checkout via PayPal. No account required — credit &amp; debit cards accepted.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- WHAT THIS BOOK IS ABOUT -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-4xl md:text-5xl font-bold text-charcoal mb-6">
            Three Steps to <span class="text-moxie-pink">Claim Your Power</span>
          </h2>
          <p class="text-xl text-gray-700 leading-relaxed mb-12">
            <em>Quit Being So Good</em> gives you a real roadmap — not platitudes. Kristi blends fifteen personal stories with practical steps you can use today.
          </p>

          <div class="grid md:grid-cols-3 gap-8 text-left">
            <!-- Step 1 -->
            <div class="bg-gray-50 rounded-2xl p-8 hover:shadow-lg transition-shadow">
              <div class="w-12 h-12 bg-moxie-pink rounded-full flex items-center justify-center mb-4">
                <span class="text-white font-bold text-xl">1</span>
              </div>
              <h3 class="text-xl font-bold text-charcoal mb-3">Be More Confident</h3>
              <p class="text-gray-600 leading-relaxed">Stop shrinking to make others comfortable. Learn to own your expertise, your voice, and your seat at the table.</p>
            </div>

            <!-- Step 2 -->
            <div class="bg-sunny-yellow rounded-2xl p-8 hover:shadow-lg transition-shadow">
              <div class="w-12 h-12 bg-charcoal rounded-full flex items-center justify-center mb-4">
                <span class="text-white font-bold text-xl">2</span>
              </div>
              <h3 class="text-xl font-bold text-charcoal mb-3">Embrace Your MOXIE</h3>
              <p class="text-gray-700 leading-relaxed">Guts. Pluck. Grit. Courage. MOXIE is what gets you through the door — and keeps you there.</p>
            </div>

            <!-- Step 3 -->
            <div class="bg-gray-50 rounded-2xl p-8 hover:shadow-lg transition-shadow">
              <div class="w-12 h-12 bg-moxie-pink rounded-full flex items-center justify-center mb-4">
                <span class="text-white font-bold text-xl">3</span>
              </div>
              <h3 class="text-xl font-bold text-charcoal mb-3">Model #WomenSupportingWomen</h3>
              <p class="text-gray-600 leading-relaxed">Because the world needs our leadership now more than ever. Rise and bring others with you.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRAISE -->
    <section class="py-20 bg-charcoal text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-4xl md:text-5xl font-bold text-center mb-4">
            What People Are <span class="text-sunny-yellow">Saying</span>
          </h2>
          <p class="text-center text-gray-400 mb-14 text-lg">Praise for <em>Quit Being So Good</em></p>

          <div class="space-y-10">

            <div class="border-l-4 border-moxie-pink pl-8">
              <p class="text-xl text-gray-200 leading-relaxed mb-4 italic">
                "If it's moxie you're looking for, Kristi Hemmer's new book has plenty of it! With humor, candor and a distinctive approach, Hemmer provides suggestions for how you can get your needs met unapologetically."
              </p>
              <p class="font-bold text-sunny-yellow">Lois P. Frankel, Ph.D.</p>
              <p class="text-gray-400 text-sm">Author of <em>Nice Girls Don't Get the Corner Office</em></p>
            </div>

            <div class="border-l-4 border-sunny-yellow pl-8">
              <p class="text-xl text-gray-200 leading-relaxed mb-4 italic">
                "In 'Quit Being So Good,' Kristi Hemmer shows girls and women they can find the deepest fulfillment from growing to become more of themselves, not shrinking to be less of who they are. It leaves you inspired, resolved and ready to use your power for good."
              </p>
              <p class="font-bold text-sunny-yellow">Emily Yellin</p>
              <p class="text-gray-400 text-sm">Journalist and Author</p>
            </div>

            <div class="border-l-4 border-moxie-pink pl-8">
              <p class="text-xl text-gray-200 leading-relaxed mb-4 italic">
                "Hemmer's personal anecdotes and expansive life view provide a courageous and unapologetic roadmap for women and girls everywhere."
              </p>
              <p class="font-bold text-sunny-yellow">Romy Newman</p>
              <p class="text-gray-400 text-sm">President and Co-Founder of Fairygodboss</p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT THE AUTHOR -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
          <div>
            <p class="text-sm uppercase tracking-widest text-moxie-pink font-bold mb-3">About the Author</p>
            <h2 class="text-4xl font-bold text-charcoal mb-6">Kristi Hemmer, M.Ed.</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-4">
              Author, Social Entrepreneur, and Sojourner. Kristi has spent her career on the frontlines of women's leadership — speaking, coaching, and writing to help women stop performing goodness and start claiming their power.
            </p>
            <p class="text-lg text-gray-700 leading-relaxed mb-8">
              "When I grow up, I want to be the first woman president, create my own school, and be an author." — <strong>Kristi Hemmer</strong>
            </p>
            <a href="/about" class="inline-block border-2 border-moxie-pink text-moxie-pink font-bold px-8 py-3 rounded-lg hover:bg-moxie-pink hover:text-white transition-colors">
              Learn More About Kristi
            </a>
          </div>
          <div class="flex justify-center">
            <img
              src="/images/QBSGcoverHemmer-400.png"
              alt="Quit Being So Good book"
              class="w-full max-w-[280px] shadow-2xl rounded-xl"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA / BUY AGAIN -->
    <section class="py-20" style="background: linear-gradient(135deg, #E91C7E 0%, #D94780 100%);">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Ready to Stop Performing Goodness?
        </h2>
        <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
          Order your copy of <em>Quit Being So Good</em> today and start claiming your power.
        </p>

        <div class="inline-block bg-white rounded-2xl shadow-2xl p-10">
          <div class="flex items-baseline gap-2 mb-2 justify-center">
            <span class="text-4xl font-bold text-charcoal">$18.95</span>
            <span class="text-gray-500 text-lg">+ $5.95 shipping</span>
          </div>
          <p class="text-sm text-gray-400 mb-6">Ships within the United States</p>

          <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_top">
            <input type="hidden" name="cmd" value="_xclick" />
            <input type="hidden" name="business" value="kristihemmer@gmail.com" />
            <input type="hidden" name="item_name" value="Quit Being So Good — Book by Kristi Hemmer" />
            <input type="hidden" name="amount" value="18.95" />
            <input type="hidden" name="shipping" value="5.95" />
            <input type="hidden" name="currency_code" value="USD" />
            <input type="hidden" name="no_shipping" value="2" />
            <input type="hidden" name="return" value="https://kristihemmer.com/thank-you" />
            <button
              type="submit"
              class="bg-[#0070BA] hover:bg-[#005ea6] text-white font-bold py-4 px-12 rounded-lg transition-colors text-lg flex items-center justify-center gap-3 mx-auto"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 101.7 121.7" class="h-6 w-auto fill-white">
                <path d="M83.5 17.3C80.4 6.7 71.7 2.8 60.4 2.8H26.6c-2.3 0-4.3 1.7-4.6 4L8.3 97.5c-.3 1.7 1 3.3 2.7 3.3h19.7l5-31.5-.2 1c.4-2.3 2.3-4 4.6-4h9.6c18.7 0 33.3-7.6 37.6-29.6.1-.6.2-1.3.3-1.9 0 0 0 0 0 0 1.3-8-.1-13.5-4.1-17.5z"/>
                <path d="M87.6 35.3c-.1.6-.2 1.3-.3 1.9-4.3 22-18.9 29.6-37.6 29.6h-9.6c-2.3 0-4.3 1.7-4.6 4l-7 44.5c-.3 1.5.9 2.9 2.4 2.9h16.7c2 0 3.7-1.5 4-3.5l.2-.8 3.2-20.1.2-1.1c.3-2 2-3.5 4-3.5h2.5c16.4 0 29.2-6.7 33-26 1.6-8.1.8-14.9-3.4-19.7-.9-1-2-1.8-3.7-2.2z"/>
              </svg>
              Buy Now — $18.95 + Shipping
            </button>
          </form>

          <p class="text-xs text-gray-400 mt-3 text-center">
            Secure checkout via PayPal. Credit &amp; debit cards accepted.
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
